# ─── Core ───────────────────────────────────────────────────────────────
# Neon: use the POOLED connection string for DATABASE_URL and the DIRECT one for DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# The one password that unlocks the app
APP_PASSWORD="choose-a-long-passphrase"
# 32+ random chars each:  openssl rand -base64 48
SESSION_SECRET=""
ENCRYPTION_KEY=""
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""
# Public URL of the deployment (used for OAuth redirects and push links)
APP_URL="http://localhost:3000"

# ─── Agent (Anthropic) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=""

# ─── Web Push (VAPID) — generate with: npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@micromex.com"

# ─── Email: Gmail API (Superhuman runs on Gmail) ────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Slack ──────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

# ─── WhatsApp Business Cloud API (Meta) ─────────────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
